{
  "schemaVersion": 1,
  "collections": [
    {
      "name": "blog",
      "label": "ブログ記事",
      "path": "src/content/blog",
      "extension": "md",
      "fields": [
        { "type": "text", "name": "title", "label": "タイトル", "required": true },
        { "type": "richtext", "name": "content", "label": "本文", "required": true },
        { "type": "date", "name": "date", "label": "公開日", "includeTime": true },
        { "type": "select", "name": "category", "label": "カテゴリ", "options": [
          { "value": "日記", "label": "日記" },
          { "value": "開発", "label": "開発" },
          { "value": "ゲーム", "label": "ゲーム" }
        ]},
        { "type": "textarea", "name": "description", "label": "概要" },
        { "type": "boolean", "name": "draft", "label": "下書き", "default": false }
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "date",
        "updatedAt": "date",
        "draft": "draft"
      }
    },
    {
      "name": "game",
      "label": "ゲーム",
      "path": "src/content/game",
      "extension": "md",
      "fields": [
        { "type": "text", "name": "title", "label": "タイトル", "required": true },
