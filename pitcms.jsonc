      "extension": "md",
      "fields": [
        { "type": "text", "name": "title", "label": "タイトル", "required": true },
        { "type": "richtext", "name": "content", "label": "本文", "required": true },
        { "type": "date", "name": "date", "label": "公開日", "includeTime": true },
        { "type": "textarea", "name": "description", "label": "概要" },
        { "type": "boolean", "name": "draft", "label": "下書き", "default": false }
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "date",
        "updatedAt": "date",
        "draft": "draft"
      }
    },
    {
      "name": "lily",
      "label": "百合",
      "path": "src/content/lily",
      "extension": "md",
      "fields": [
        { "type": "text", "name": "title", "label": "タイトル", "required": true },
        { "type": "richtext", "name": "content", "label": "本文", "required": true },
        { "type": "date", "name": "date", "label": "公開日", "includeTime": true },
        { "type": "textarea", "name": "description", "label": "概要" },
        { "type": "boolean", "name": "draft", "label": "下書き", "default": false }
      ],
