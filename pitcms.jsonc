        { "type": "date", "name": "date", "label": "公開日", "includeTime": true },
        { "type": "select", "name": "category", "label": "カテゴリ", "options": [
          { "value": "ファイアーエムブレム", "label": "ファイアーエムブレム" },
          { "value": "ネクタリス", "label": "ネクタリス" }
        ]},
        { "type": "textarea", "name": "description", "label": "概要" },
        { "type": "boolean", "name": "draft", "label": "下書き", "default": false }
      ],
      "pit": {
        "title": "title",
        "body": "content",
        "createdAt": "date",
        "updatedAt": "date",
        "draft": "draft"
      }
    },
    {
      "name": "creation",
      "label": "創作",
