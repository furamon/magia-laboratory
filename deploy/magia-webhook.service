# Magia Laboratory（GitHub Webhook）systemd サービスユニット
# 配置先: /etc/systemd/system/magia-webhook.service
# 有効化: systemctl enable --now magia-webhook
# Cloudflare Tunnel で 4322 ポートの /hooks を公開する

[Unit]
Description=Magia Laboratory (GitHub Webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=furamon
WorkingDirectory=/opt/magia-laboratory
Environment=PORT=4322
# ProtectHome=true で /root は読めないため、書き込み可能な作業ディレクトリを HOME にする
Environment=HOME=/opt/magia-laboratory
EnvironmentFile=/opt/magia-laboratory/.env
ExecStart=/usr/local/bin/bun buildHooks.ts
Restart=always
RestartSec=3
# セキュリティ強化（任意）
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
