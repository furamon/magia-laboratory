# Magia Laboratory（Astro SSR）systemd サービスユニット
# 配置先: /etc/systemd/system/magia-laboratory.service
# 有効化: systemctl enable --now magia-laboratory

[Unit]
Description=Magia Laboratory (Astro SSR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=furamon
WorkingDirectory=/opt/magia-laboratory
Environment=HOST=0.0.0.0
Environment=PORT=4321
# ProtectHome=true で /root は読めないため、書き込み可能な作業ディレクトリを HOME にする
Environment=HOME=/opt/magia-laboratory
EnvironmentFile=/opt/magia-laboratory/.env
ExecStart=/usr/local/bin/bun ./dist/server/entry.mjs
Restart=always
RestartSec=3
# セキュリティ強化（任意）
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
