---
import { getCollection } from "astro:content";
import ContentIndex from "../components/ContentIndex.svelte";
import Layout from "../layouts/Layout.astro";

const entries = (await getCollection("game", ({ data }) => !data.draft)).map(
	(entry) => ({ slug: entry.id, data: entry.data }),
);
---

<Layout title="Game" description="ゲーム攻略など">
	<div class="mx-auto max-w-5xl">
		<h1 class="text-5xl font-bold mb-8">ゲームのページ</h1>

		<div
			class="grid gap-4 grid-cols-1 sm:grid-cols-2 [&>div]:flex [&>div]:flex-col"
		>
			<div>
				<a href="/game/guide" class="btn-game">げーむのやりこみ</a>
				<p>一応メイン。レトロゲームの取っ掛かりに。</p>
			</div>
			<div>
				<a href="/game/playdiary" class="btn-game">プレイ日記</a>
				<p>レビューっぽかったり攻略メモ付きだったりいろいろ。</p>
			</div>
			<div>
				<a href="/game/talk" class="btn-game">小話</a>
				<p>ゲームとかについての好き語りいろいろ。</p>
			</div>
			<div>
				<a
					href="https://www.notion.so/furamon913/cd55e04977734af082130ce34477dc31?v=5d7d04f5d1e84bc4ab45625fddd98475&pvs=4"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-game"
				>
					所持ゲームリスト（Notion）
				</a>
				<p>持ってるゲームのやりこんだかリスト。</p>
			</div>
		</div>

		<ContentIndex entries={entries} baseHref="/game" />
	</div>
</Layout>
