---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { TOP_CATEGORY_LINKS } from "../lib/site";

/** カテゴリ見出しのリンク先（Game / Creation / Lily のみリンク） */
const categoryHref: Record<string, string> = {
	Game: "/game",
	Creation: "/creation",
	Lily: "/lily",
};

/** 最新のブログ記事（公開済みのみ、日付降順の先頭 1 件） */
const latestPost = (
	await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""))[0];

const { Content } = await render(latestPost);
---

<Layout>
	<div class="mx-auto max-w-5xl">
		<div class="text-center mb-12">
			<h1 class="text-5xl font-bold">Magia Laboratory</h1>
			<div class="text-xl font-bold">ゲーム攻略、百合作品などのサイト。</div>
		</div>

		<div
			class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 justify-center text-center [&_a]:block"
		>
			{TOP_CATEGORY_LINKS.map((category) => (
					<div class="flex flex-col gap-4">
						{categoryHref[category.label] ? (
							<a
								href={categoryHref[category.label]}
								class="text-4xl font-medium underline"
							>
								{category.label}
							</a>
						) : (
							<div class="text-4xl font-medium">{category.label}</div>
						)}
						<div class="flex flex-col gap-2">
							{category.links.length === 0 ? (
								<span>Coming Soon...</span>
							) : (
								category.links.map((link) =>
									link.external ? (
										<a
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="btn-game"
										>
											{link.label}
										</a>
									) : (
										<a href={link.href} class="btn-game">
											{link.label}
										</a>
									),
								)
							)}
						</div>
					</div>
				))}
		</div>

		<div class="mt-16">
			<h2 class="text-3xl font-bold mb-6">最新のブログ記事</h2>
			<article
				class="prose prose-neutral dark:prose-invert prose-img:mx-auto prose-img:my-auto max-w-full prose-headings:font-semibold prose-headings:text-black dark:prose-headings:text-white"
			>
				<h3 class="text-2xl font-semibold text-black dark:text-white">
					<a href={`/blog/${latestPost.id}`}>{latestPost.data.title}</a>
				</h3>
				<p class="text-sm text-gray-500">{latestPost.data.date}</p>
				<Content />
			</article>
		</div>
	</div>
</Layout>
