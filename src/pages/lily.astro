---
import { getCollection } from "astro:content";
import ContentIndex from "../components/ContentIndex.svelte";
import Layout from "../layouts/Layout.astro";

const entries = (await getCollection("lily", ({ data }) => !data.draft)).map(
	(entry) => ({ slug: entry.id, data: entry.data }),
);
---

<Layout title="Lily" description="百合作品" lilyPage>
	<div class="mx-auto max-w-5xl [&>p]:mb-4">
		<h2 class="mb-8 text-center text-3xl font-bold">
			おさわり、お持ち帰り、俺嫁もろもろ厳禁ですわっ！
		</h2>
		<p>
			白百合ーー白く麗しくもたくましい純潔の花。
			<br>
			転じて……女の子同士の「トクベツ」な感情。切なく儚く柔らかく強く……。
		</p>
		<p>
			ということで百合作品（漫画・小説・アニメ・映画）などのレビューや考察の部屋です。ゲーム関連も百合メインのトークであればここに。まだ百合道は日が浅いですが、どうかお暇つぶしにでも。
		</p>

		<div
			class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2 [&>div]:flex [&>div]:flex-col"
		>
			<div>
				<span class="btn-lily block">メディア関連</span>
				<p>映画小説マンガアニメ問わず百合（っぽいの含む）作品のだべり。</p>
			</div>
			<div>
				<span class="btn-lily block">小話</span>
				<p>百合についてのだべり。ツッコミ大歓迎でしてよ。</p>
			</div>
		</div>

		<h2 class="mb-4 text-center text-2xl font-bold">おまけ - 管理人百合歴</h2>
		<ol class="list-decimal pl-6 mb-8">
			<li>身内が見ていた「ゆるゆり」を一緒に見る</li>
			<li>
				その頃はピンとこなかったが、あるMADを見て「この娘たちがかっこよく戦ったら……」と妄想するように。邪道
			</li>
			<li>
				その後ずいぶん経って精神的にいろいろあり、癒しを求めて百合を漁った結果「Bang
				Dream!」の某双子姉妹に出会う。「キャラの関係性の魅力」だけでここまで心を動かせるのかと可能性を発見
			</li>
			<li>沼へ</li>
		</ol>

		<ContentIndex entries={entries} baseHref="/lily" />
	</div>
</Layout>
