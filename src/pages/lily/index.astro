---
import { getEntry, render } from "astro:content";
import Layout from "@layouts/Layout.astro";

const entry = await getEntry("lily", "index");
if (!entry) {
	throw new Error("lily コレクションの index.md が見つかりません");
}
const { Content } = await render(entry);
---

<Layout title="Lily" description="百合作品" lilyPage>
	<div class="mx-auto max-w-5xl [&>p]:mb-4">
		<h2 class="mb-8 text-center text-3xl font-bold">
			おさわり、お持ち帰り、俺嫁もろもろ厳禁ですわっ！
		</h2>

		<div class="prose prose-neutral dark:prose-invert max-w-full">
			<Content />
		</div>

		<div
			class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2 [&>div]:flex [&>div]:flex-col"
		>
			{entry.data.links?.map((link) => (
				<div>
					{link.href ? (
						link.external ? (
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="btn-lily block"
							>
								{link.label}
							</a>
						) : (
							<a href={link.href} class="btn-lily block">
								{link.label}
							</a>
						)
					) : (
						<span class="btn-lily block">{link.label}</span>
					)}
					{link.description ? <p>{link.description}</p> : null}
				</div>
			))}
		</div>
	</div>
</Layout>
