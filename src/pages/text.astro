---
import { getCollection } from "astro:content";
import ContentIndex from "../components/ContentIndex.svelte";
import Layout from "../layouts/Layout.astro";

const entries = (await getCollection("text", ({ data }) => !data.draft)).map(
	(entry) => ({ slug: entry.id, data: entry.data }),
);
---

<Layout title="Text" description="テキスト">
	<div class="mx-auto max-w-5xl [&>p]:mb-4">
		<h1 class="text-5xl font-bold mb-8">雑記おき</h1>

		<p>攻略等の置き場所がない文書の集い。</p>

		<div
			class="grid grid-cols-1 gap-4 sm:grid-cols-2 [&>div]:flex [&>div]:flex-col"
		>
			<div>
				<a href="/text/develop" class="btn-game">パソコン・ガジェット関連</a>
			</div>
		</div>

		<ContentIndex entries={entries} baseHref="/text" />
	</div>
</Layout>
